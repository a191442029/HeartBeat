<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- BLE: 本应用直连手环采集(角色与服务端EXE一致), 8.0/8.1 用旧权限模型 -->
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <!-- BLE扫描在 Android 6.0~11 必须有定位权限(运行时申请) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- 手环自动重连需要常驻唤醒 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 悬浮窗: TYPE_APPLICATION_OVERLAY 所需特殊权限(设置页授权) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Android 8.0+ 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- 直接申请电池优化白名单(长期通电常驻) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: InfluxDB/Bark/ntfy/WS均为明文HTTP, 安卓9+默认禁明文会静默拒绝;
             局域网/Tailscale隧道内明文可接受(与EXE行为一致) -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false"/>

        <activity android:name=".RecordsActivity" android:exported="false"/>

        <service
            android:name=".HeartRateService"
            android:exported="false"/>

    </application>
</manifest>
