<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1E26"
    android:padding="10dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESP32 中继"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/accent"/>

    <CheckBox
        android:id="@+id/chk_relay_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="启用中继中枢 (0.0.0.0:8899 · mDNS _hrmlink._tcp 自动发现)"/>

    <!-- 仲裁参数行1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="切换阈值:"
            android:textSize="12sp"
            android:textColor="#999999"/>

        <EditText
            android:id="@+id/edit_relay_drop"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:inputType="numberSigned"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="迟滞dB:"
            android:textSize="12sp"
            android:textColor="#999999"/>

        <EditText
            android:id="@+id/edit_relay_hyst"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="最低RSSI:"
            android:textSize="12sp"
            android:textColor="#999999"/>

        <EditText
            android:id="@+id/edit_relay_min"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:inputType="numberSigned"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:gravity="center"/>
    </LinearLayout>

    <!-- 仲裁参数行2 + 刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="接管判定秒:"
            android:textSize="12sp"
            android:textColor="#999999"/>

        <EditText
            android:id="@+id/edit_relay_stale"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="冻结周期:"
            android:textSize="12sp"
            android:textColor="#999999"/>

        <EditText
            android:id="@+id/edit_relay_freeze"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:gravity="center"/>

        <Button
            android:id="@+id/btn_relay_refresh"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginLeft="12dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="刷新节点"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- 节点表头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#23252E"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textSize="11sp"
            android:textColor="#999999"
            android:text="节点"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="#999999"
            android:text="信号"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="#999999"
            android:text="状态"/>

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#999999"
            android:text="标定"/>

        <TextView
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#999999"
            android:text="操作"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/list_relay_nodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#777777"
        android:text="标定=信号偏差(dB, 正值调强): RSSI 实测偏弱可加正偏差参与仲裁, 对齐 EXE 信号标定; 改名/重启远程下发, 删除仅移除登记"/>

    <!-- 报警视频联动 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="报警视频联动 (节点房间 → 相机, 报警时优先切该相机)"
        android:textSize="13sp"
        android:textColor="#CCCCCC"/>

    <LinearLayout
        android:id="@+id/list_roomcam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <Button
        android:id="@+id/btn_add_roomcam"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:layout_marginTop="4dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="+ 添加绑定"
        android:textSize="12sp"/>
</LinearLayout>
