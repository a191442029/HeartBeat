<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1E26"
    android:padding="10dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="存储"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/accent"/>

    <TextView
        android:id="@+id/txt_usb_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#777777"
        android:text="U 盘: 检测中…"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="建议: 报警剪辑存 U 盘(大文件冷数据, 拔盘即看); U 盘未挂载自动回退板载, 更改仅对新文件生效"
        android:textSize="11sp"
        android:textColor="#777777"/>

    <!-- 报警剪辑 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/chk_arch_clip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="报警剪辑存档"/>

        <Spinner
            android:id="@+id/spin_clip_storage"
            android:layout_width="130dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- 心率CSV日志 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/chk_arch_csv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="心率CSV日志存档"/>

        <Spinner
            android:id="@+id/spin_csv_storage"
            android:layout_width="130dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="保留"
            android:textSize="12sp"
            android:textColor="#999999"/>

        <EditText
            android:id="@+id/edit_csv_retention"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="12sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="天"
            android:textSize="12sp"
            android:textColor="#999999"/>
    </LinearLayout>

    <!-- 推送记录 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/chk_arch_pushlog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="推送记录存档"/>

        <Spinner
            android:id="@+id/spin_pushlog_storage"
            android:layout_width="130dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
