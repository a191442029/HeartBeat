<?xml version="1.0" encoding="utf-8"?>
<!-- 竖屏兼容布局: 上顶栏, 中部大号心率+状态行+波形, 底部按钮行左对齐 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#14141A"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <!-- 顶栏: 应用名+版本 | 设置按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HRHub服务端"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txt_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="v1.0"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="设置"/>
    </LinearLayout>

    <!-- 中部: 大号心率+心形 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/img_heart"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_heart"/>

            <TextView
                android:id="@+id/txt_hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="--"
                android:textColor="#FF5A5A"
                android:textSize="72sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txt_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="BPM"
                android:textColor="#FF5A5A"
                android:textSize="22sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="设备: 未配置设备 | 连接: 未连接 | WS客户端: 0 | 服务地址: auto:8765"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- 波形占满剩余空间 -->
    <com.hrmlink.hrserver.HeartWaveView
        android:id="@+id/wave"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"/>

    <!-- 底部按钮行: 横排左对齐 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#999999"
            android:text="监测服务已自动运行(启停/悬浮窗开关在设置页)"/>
    </LinearLayout>
</LinearLayout>
