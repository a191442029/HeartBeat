<?xml version="1.0" encoding="utf-8"?>
<!-- 竖屏: 系统标题栏(标题=HRBubble+日期时间, 右侧菜单=设置/悬浮窗/监测), 其下状态行, 中部大号心率+实时波形 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#14141A"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <!-- 状态行: 数据源状态点 + 服务状态文本 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/dot_home"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/dot_bg"/>

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text="未启动"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/img_heart"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_heart"/>

            <TextView
                android:id="@+id/txt_hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="--"
                android:textColor="#FF5A5A"
                android:textSize="88sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txt_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="BPM"
                android:textColor="#FF5A5A"
                android:textSize="22sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txt_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="--:--:--"
            android:textColor="#CCCCCC"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/txt_reconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#FFA726"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone"/>

        <com.hrmlink.hrbubble.HeartWaveView
            android:id="@+id/wave"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"/>
    </LinearLayout>
</LinearLayout>
